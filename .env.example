# Copy to .env and fill in. Never commit .env.
# Generate a secret with:  openssl rand -hex 32
JWT_SECRET=
MONGO_URI=mongodb://mongo:27017/student-task-manager
PORT=5000
# Comma-separated extra origins allowed by CORS (e.g. the Vite dev server)
CORS_ORIGINS=http://localhost:8080
# Max login/register attempts per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=100
# Grafana admin password (monitoring overlay)
GRAFANA_ADMIN_PASSWORD=
# Image name used by Jenkins / GitHub Actions when publishing
IMAGE_NAME=student-task-manager
