{
  "title": "Student Task Manager",
  "uid": "stm-app",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    { "id": 1, "type": "timeseries", "title": "Requests per second by route", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (route, method) (rate(http_request_duration_seconds_count[1m]))", "legendFormat": "{{method}} {{route}}" }] },
    { "id": 2, "type": "timeseries", "title": "p95 latency (s)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95" }] },
    { "id": 3, "type": "timeseries", "title": "Responses by status", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (status) (rate(http_request_duration_seconds_count[1m]))", "legendFormat": "{{status}}" }] },
    { "id": 4, "type": "timeseries", "title": "Memory (RSS bytes)", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "process_resident_memory_bytes", "legendFormat": "rss" }] }
  ]
}
